# syntax=docker/dockerfile:1.7
# VANTA PaperMC server image. Multi-stage:
#   1. plugin build (gradle:8.10.2-jdk21 — toolchain pins mirror versions.json)
#   2. paper runtime (eclipse-temurin:21-jre + the pinned paper jar from vendor/)
#
# Plugin source lives under bridge-plugin/. Paper jar is downloaded
# host-side by installer.sh (or `bash installer.sh`) and committed
# into vendor/paper/ (gitignored binary; the .schem world blobs in
# world/schems/ are the only Paper-side binaries we DO commit per
# §1.2). Build context is repo root so the COPY paths line up.

FROM gradle:8.10.2-jdk21 AS plugin-build
WORKDIR /build
COPY bridge-plugin/ ./
RUN gradle --no-daemon shadowJar

FROM eclipse-temurin:21-jre
WORKDIR /paper

# Pinned Paper jar — vendor/paper/paper-1.21.4.jar is build-fetched
# by installer.sh. The container does NOT re-download at runtime.
COPY vendor/paper/paper-1.21.4.jar /paper/paper.jar

# Bring in the freshly built plugin from stage 1.
COPY --from=plugin-build /build/build/libs/vanta-bridge-0.1.0.jar /paper/plugins/vanta-bridge.jar

# EULA accepted at build time. Mojang requires explicit acceptance
# on every Paper start; baking it in keeps the compose path one-shot.
RUN echo "eula=true" > /paper/eula.txt

# Minimal server.properties for the local-first compose. Online-mode=false
# lets us join with cracked clients; the runtime is the source of truth
# for identity, the Minecraft account is just a player handle.
RUN printf '%s\n' \
    "online-mode=false" \
    "server-port=25565" \
    "motd=VANTA - the company you can walk inside" \
    "max-players=20" \
    "spawn-protection=0" \
    "view-distance=32" \
    "simulation-distance=32" \
    "enable-rcon=false" \
    "difficulty=peaceful" \
    "spawn-monsters=false" \
    "level-seed=plains" \
    > /paper/server.properties

# Disable Paper's connection-throttle. Default is 4000 ms per IP, which
# rate-limits all 7 NPC bots into a kick/reconnect loop because they
# share the npcs container's IP. The local-first compose has no
# adversarial connection-flood threat model — every connecting IP is
# either us, our bots, or a visitor — so disabling the throttle is
# safe and necessary for the population to actually show up.
RUN mkdir -p /paper && printf '%s\n' \
    "settings:" \
    "  connection-throttle: 0" \
    "  bungeecord: false" \
    > /paper/spigot.yml

EXPOSE 25565
# Heap sized to fit inside Docker Desktop's default 3.8 GiB VM on
# laptops; production overrides Xmx via JAVA_OPTS at deploy time.
# Aikar GC flags (de-facto Paper standard).
CMD ["sh", "-c", "exec java ${JAVA_OPTS:--Xms1G -Xmx2G} \
     -XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 \
     -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC \
     -XX:G1HeapRegionSize=8M \
     -jar paper.jar --nogui"]
