{
  "name": "@vanta/tee",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "VANTA TEE substrate: Ed25519 in-enclave signing keypair, HKDF-SHA-256 derivation per paper §7, EigenCloud KMS attestation client. Implements paper Invariants 1, 5.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@layr-labs/ecloud-sdk": "0.5.0",
    "@noble/ed25519": "2.3.0",
    "@noble/hashes": "1.8.0",
    "jose": "6.1.3",
    "viem": "2.22.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
