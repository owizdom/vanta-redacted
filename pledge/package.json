{
  "name": "@vanta/pledge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "VANTA pledge orchestrator: composes @vanta/venue-poly (CTF reads + Safe signer) and @vanta/events (loan.pledge body) into a signed pledge pipeline that enforces the I-PL-* invariants.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "lint": "eslint src tests",
    "typecheck": "tsc --build --noEmit"
  },
  "dependencies": {
    "@vanta/events": "workspace:*",
    "@vanta/tee": "workspace:*",
    "@vanta/venue-poly": "workspace:*",
    "canonicalize": "3.0.0",
    "viem": "2.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@noble/ed25519": "2.3.0",
    "@types/node": "^22.10.0"
  }
}
