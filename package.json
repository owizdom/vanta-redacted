{
  "name": "vanta",
  "private": true,
  "version": "0.0.0",
  "description": "An autonomous risk engine for prediction-market credit. Where Gondor's curator sits.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": "20.11.0",
    "pnpm": "9.12.0"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "typecheck": "tsc --build",
    "forge:build": "cd contracts && forge build",
    "forge:test": "cd contracts && forge test",
    "start": "pnpm --filter @vanta/runtime start",
    "dev": "tsx scripts/dev.ts",
    "demo": "tsx scripts/demo.ts",
    "anvil:up": "bash scripts/anvil-up.sh",
    "anvil:down": "bash scripts/anvil-down.sh",
    "deploy:local": "bash scripts/deploy-local.sh",
    "web:dev": "pnpm --filter @vanta/web dev",
    "web:build": "pnpm --filter @vanta/web build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
