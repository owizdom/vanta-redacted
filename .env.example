# RPCs (testnet)
BASE_RPC=https://sepolia.base.org
AMOY_RPC=https://rpc-amoy.polygon.technology

# Local devnet (anvil forks)
LOCAL_BASE_RPC=http://localhost:8545
LOCAL_AMOY_RPC=http://localhost:8546

# Local-dev seed (gitignored at .vanta/dev-seed; production seeds come from KMS attestation)
VANTA_DEV_SEED=

# Polymarket data
POLYMARKET_CLOB_BASE=https://clob.polymarket.com
POLYMARKET_GATEWAY=https://gateway-api.polymarket.com

# Inference — EigenCloud AI Gateway. No keys needed; @layr-labs/ai-gateway-provider
# auto-fetches per-call JWTs via TEE attestation when KMS_SERVER_URL +
# KMS_PUBLIC_KEY are set (auto-injected inside EigenCompute).
EIGEN_GATEWAY_URL=https://ai-gateway-dev.eigencloud.xyz
# JWT audience. Upstream `eigen()` defaults to `'llm-proxy'`; our deploy
# hits a `crypto/rsa: verification error` against that audience while
# the same KMS mints externally-verified `vanta.app` JWTs at boot. Use
# the diagnostic probe at /api/dev/probe-eigen to confirm which audience
# the gateway accepts for your appId.
INFERENCE_AUDIENCE=vanta.app
# Flip to true to log the eigen provider's request URL + redacted
# headers + body via console.log. Off by default.
INFERENCE_DEBUG=false
# Force a static JWT (skips AttestClient entirely). Diagnostic-only.
INFERENCE_STATIC_JWT=
INFERENCE_MODEL_ANTHROPIC=anthropic/claude-sonnet-4-6
INFERENCE_MODEL_OPENAI=openai/gpt-5
INFERENCE_MODEL_GOOGLE=google/gemini-2.5-pro

# ---------------------------------------------------------------------
# Inference backend selector (eigen | vercel)
#
# `eigen`  — KMS-JWT path via @layr-labs/ai-gateway-provider. Agent self-
#            funds, billed to its own EigenCompute account. As of
#            2026-05-02 every JWT we mint is rejected by the gateway with
#            `crypto/rsa: verification error` (reproducible with the
#            official Layr-Labs/ecloud-inference-example deployed
#            unmodified) — staged but inactive until Eigen ships a fix.
#            Re-run /api/dev/probe-eigen to confirm when fixed.
#
# `vercel` — Vercel AI Gateway, OpenAI-compatible. Operator-held bearer
#            (`VERCEL_AI_GATEWAY_KEY`); operator pays Vercel in fiat. The
#            agent's spend is still bounded on chain by
#            VendorPayment(Inference)'s immutable weekly cap, so a
#            compromised key cannot drain more than the cap allows.
#
# Default: `vercel` until the Eigen gateway is fixed. Flip to `eigen` once
# the probe returns a non-401.
# ---------------------------------------------------------------------
INFERENCE_BACKEND=vercel
VERCEL_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh
VERCEL_AI_GATEWAY_KEY=

# X402 metering (default off)
X402_ENABLED=false
X402_USDC_BASE=

# Mark fixtures (offline test mode)
MARK_FIXTURE_DIR=

# Watchable layer (Phase 10)
ELEVENLABS_API_KEY=
PAPER_SERVER_HOST=localhost
PAPER_SERVER_PORT=25565
VIEWER_HTTP_PORT=8080

# ---------------------------------------------------------------------
# Payouts (paper §7+§8 — agent self-funds its own bills)
#
# Three independently-gated buckets. All ship OFF by default; flip
# *_ENABLED=1 only after a verified live disbursement per bucket.
#
# Tier 1 (Direct, on-chain end-to-end):
#   - Gas: USDC → ETH via Uniswap V3 multicall, signed by treasury,
#     ETH lands on the admin EOA.
#   - Inference (when enabled at the LLM endpoint): per-call EIP-3009
#     USDC.transferWithAuthorization signed by treasury via the x402
#     client. Activates the moment AI_GATEWAY_BASE_URL points at an
#     x402-metered LLM endpoint; otherwise the T2 budget covers it.
#
# Tier 2 (Contract-mediated, immutable cap):
#   - Hosting + Inference (fallback) via VendorPayment contracts. The
#     contract enforces an on-chain weekly cap; even a compromised
#     runtime cannot exceed it. Cap is immutable post-deploy; raising
#     it requires a fresh deploy under a new constitutional ref.
# ---------------------------------------------------------------------

# Operator address — receives the weekly USDC stream from VendorPayment
# contracts. Required when PAYOUTS_HOSTING_ENABLED or _INFERENCE_ENABLED
# is set. The operator settles vendor bills in fiat downstream.
VANTA_OPERATOR_ADDRESS=

# Master switch: log calldata, never broadcast. Use for first verified
# tick after deploy; flip to 0 only after the calldata is sanity-checked
# against Uniswap + VendorPayment ABIs.
PAYOUTS_DRY_RUN=0

# --- Gas refill (T1 Direct) ---
PAYOUTS_GAS_ENABLED=0
PAYOUTS_GAS_LOW_WEI=5000000000000000      # 0.005 ETH
PAYOUTS_GAS_HIGH_WEI=15000000000000000    # 0.015 ETH
PAYOUTS_GAS_TICK_CAP_USDC6=2000000        # 2 USDC per tick
PAYOUTS_GAS_WEEKLY_CAP_USDC6=10000000     # 10 USDC rolling 7d
PAYOUTS_GAS_SLIPPAGE_BPS=100              # 1%
PAYOUTS_GAS_POOL_FEE=500                  # Uniswap V3 0.05%

# --- Hosting (T2 Contract-mediated) ---
# VendorPayment deploy address (from contracts/script/05_VendorPayment.s.sol)
PAYOUTS_HOSTING_ENABLED=0
PAYOUTS_HOSTING_CONTRACT_ADDRESS=
PAYOUTS_HOSTING_WEEKLY_USDC6=55270000     # $55.27 — match the contract's immutable cap
PAYOUTS_HOSTING_CONSTITUTIONAL_REF=

# --- Inference (T1 when x402; T2 fallback always) ---
PAYOUTS_INFERENCE_ENABLED=0
PAYOUTS_INFERENCE_CONTRACT_ADDRESS=
PAYOUTS_INFERENCE_WEEKLY_USDC6=10000000   # $10
PAYOUTS_INFERENCE_CONSTITUTIONAL_REF=
# Optional override — when set, inference is routed through this URL
# via the outbound x402 client (per-call EIP-3009 settlements). Leave
# unset to keep using AI_GATEWAY_BASE_URL with a Bearer token.
PAYOUTS_INFERENCE_X402_URL=
