# VANTA runtime — mainnet-alpha env template.
#
# Copy to runtime/.env.mainnet (gitignored), fill in the secrets, then
# pass to ecloud at deploy time:
#
#   ecloud compute app upgrade <APP-ID> --verifiable \
#     --repo https://github.com/owizdom/vanta \
#     --commit $(git rev-parse HEAD) \
#     --env-file runtime/.env.mainnet
#
# The runtime reads MNEMONIC at boot, derives the admin EOA via HKDF
# (deriveOriginationEOA), then verifies it matches LpVault.owner() and
# LoanBook.owner() per I-RT-2. Mismatch → fail-closed.

# ----- Network ------------------------------------------------------
PORT=8787
HOST=0.0.0.0
VANTA_DATA_DIR=/vanta-data

# ----- Chain RPCs ---------------------------------------------------
# Base mainnet for LpVault + LoanBook + VendorPayment.
# Polygon mainnet for VantaVault (CTF escrow).
LOAN_BOOK_RPC_URL=https://mainnet.base.org
AMOY_RPC_URL=https://polygon-rpc.com

# ----- Contract addresses ------------------------------------------
# Filled in after `pnpm deploy:mainnet` writes contracts/deployments/
# mainnet-{base,polygon}.json. The runtime auto-reads from there if
# the env vars are unset, but explicit values win.
LOAN_BOOK_ADDRESS=
LP_VAULT_ADDRESS=
EXPECTED_ADMIN=
DEPLOYMENTS_DIR=/app/contracts/deployments

# ----- Operator identity (HKDF source) -----------------------------
# 32-byte hex from `pnpm tsx scripts/derive-mainnet-admin.ts`.
# This is the source-of-truth. Lose it → lose admin control.
MNEMONIC=

# ----- Inference (Eigen Gateway, mainnet-alpha) --------------------
INFERENCE_BACKEND=eigen
EIGEN_GATEWAY_URL=https://ai-gateway.eigencloud.xyz
INFERENCE_AUDIENCE=vanta.app
INFERENCE_MODEL_ANTHROPIC=anthropic/claude-sonnet-4-6
INFERENCE_MODEL_OPENAI=openai/gpt-5
INFERENCE_MODEL_GOOGLE=google/gemini-2.5-pro

# ----- X402 metering (off by default; on after first paid call) ---
X402_ENABLED=0

# ----- Payouts (off until first verified disbursement per bucket) -
PAYOUTS_GAS_ENABLED=0
PAYOUTS_HOSTING_ENABLED=0
PAYOUTS_INFERENCE_ENABLED=0

# ----- Demo admin (MUST stay 0 in prod) ----------------------------
# When set to 1, /admin/demo/* routes are exposed (used by the demo
# runner + borrower-flow synthetic origination path). NEVER on in
# prod — it lets anyone append signed events to the log.
VANTA_DEMO_ADMIN=0
