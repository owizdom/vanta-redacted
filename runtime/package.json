{
  "name": "@vanta/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "VANTA runtime: boots TEE, opens event log, runs three continuous reasoning loops (credit, model, operational) per paper §7, exposes HTTP surface on fastify.",
  "main": "./dist/main.js",
  "exports": {
    ".": "./dist/main.js"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "smoke": "tsx src/loops/smoke.ts",
    "smoke:onboarding": "tsx src/onboarding/smoke.ts",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@layr-labs/ai-gateway-provider": "^1.0.1",
    "@vanta/constitution": "workspace:*",
    "@vanta/events": "workspace:*",
    "@vanta/haircut": "workspace:*",
    "@vanta/mark": "workspace:*",
    "@vanta/origination": "workspace:*",
    "@vanta/pledge": "workspace:*",
    "@vanta/tee": "workspace:*",
    "@vanta/treasury": "workspace:*",
    "@vanta/venue-poly": "workspace:*",
    "@vanta/verify": "workspace:*",
    "ai": "^6.0.174",
    "canonicalize": "3.0.0",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^3.0.0",
    "viem": "2.22.0",
    "zod": "3.24.1",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
