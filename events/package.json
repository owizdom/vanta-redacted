{
  "name": "@vanta/events",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "VANTA event schema, canonical JSON build-and-sign, decode, and verifier. Implements paper Invariant 3 (public provenance) — typed JSON records signed by the in-enclave Ed25519 key.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@noble/ed25519": "2.3.0",
    "@vanta/tee": "workspace:*",
    "canonicalize": "3.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
