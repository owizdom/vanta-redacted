# LaTeX paper build — produces paper/vanta.pdf from paper/vanta.tex.
FROM eclipse-temurin:21-jdk-jammy

RUN apt-get update && apt-get install -y --no-install-recommends \
      texlive-latex-base texlive-fonts-recommended texlive-latex-extra texlive-fonts-extra \
      lmodern \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /paper
COPY paper/ ./

# Two passes for cross-references.
RUN pdflatex -interaction=nonstopmode -halt-on-error vanta.tex \
 && pdflatex -interaction=nonstopmode -halt-on-error vanta.tex

CMD ["sh", "-c", "ls -la vanta.pdf"]
